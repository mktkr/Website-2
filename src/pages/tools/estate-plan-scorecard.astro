---
// src/pages/tools/estate-plan-scorecard.astro
const title = "Estate Plan Scorecard | Mesa Estate Planning";
const description = "Answer a few quick questions to discover what estate plan fits your life, what protections you need, and what it might cost. Free, no login required.";
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href="https://www.mesaestateplanninglawyer.com/tools/estate-plan-scorecard" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://www.mesaestateplanninglawyer.com/tools/estate-plan-scorecard" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/styles/global.css" />
  <style>
    /* ── Scorecard Scoped Styles ── */
    :root {
      --sc-sage: #5C7A6B;
      --sc-sage-light: #6B8C7A;
      --sc-sage-dark: #4A6557;
      --sc-sage-faint: rgba(92, 122, 107, 0.06);
      --sc-bronze: #9C7E4A;
      --sc-bronze-light: #B8995E;
      --sc-cream: #FAF8F4;
      --sc-dark: #2C2C2C;
      --sc-body: #4A4A4A;
      --sc-muted: #7A7A7A;
      --sc-border: #E8E4DC;
      --sc-white: #FFFFFF;
      --sc-serif: 'Cormorant Garamond', Georgia, serif;
      --sc-sans: 'DM Sans', -apple-system, sans-serif;
    }

    .sc-wrap {
      max-width: 480px;
      margin: 0 auto;
      padding: 0 0 64px;
      font-family: var(--sc-sans);
      color: var(--sc-body);
    }

    /* Screens */
    .sc-screen {
      display: none;
      opacity: 0;
      transform: translateY(14px);
    }
    .sc-screen.active {
      display: block;
      animation: scFadeIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    @keyframes scFadeIn {
      to { opacity: 1; transform: translateY(0); }
    }

    /* Header bar */
    .sc-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 18px 24px;
      border-bottom: 1px solid var(--sc-border);
      background: var(--sc-white);
    }
    .sc-header-left {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .sc-header-icon {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      background: var(--sc-sage);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .sc-header-title {
      font-size: 14px;
      font-weight: 600;
      color: var(--sc-dark);
    }
    .sc-header-step {
      font-size: 13px;
      color: var(--sc-muted);
      font-weight: 500;
    }

    /* Progress bar */
    .sc-progress {
      display: flex;
      gap: 6px;
      padding: 16px 24px 0;
      margin-bottom: 28px;
    }
    .sc-progress-seg {
      flex: 1;
      height: 3px;
      border-radius: 2px;
      background: var(--sc-border);
      transition: background 0.4s ease;
    }
    .sc-progress-seg.filled {
      background: var(--sc-sage);
    }

    /* Content area */
    .sc-content {
      padding: 0 24px;
    }

    /* Typography */
    .sc-heading {
      font-family: var(--sc-serif);
      font-size: 26px;
      font-weight: 600;
      color: var(--sc-dark);
      line-height: 1.2;
      margin: 8px 0 6px;
    }
    .sc-heading-lg {
      font-size: 34px;
    }
    .sc-subtext {
      font-size: 15px;
      color: var(--sc-muted);
      margin: 0 0 22px;
      line-height: 1.5;
    }
    .sc-label {
      display: block;
      font-size: 12px;
      font-weight: 600;
      color: var(--sc-muted);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 10px;
    }

    /* Option cards — radio (single select) */
    .sc-option {
      display: flex;
      align-items: center;
      gap: 14px;
      width: 100%;
      padding: 15px 18px;
      border: 1.5px solid var(--sc-border);
      border-radius: 10px;
      background: var(--sc-white);
      cursor: pointer;
      transition: all 0.2s ease;
      text-align: left;
      outline: none;
      font-family: var(--sc-sans);
      margin-bottom: 10px;
      box-sizing: border-box;
    }
    .sc-option:hover {
      border-color: var(--sc-sage-light);
    }
    .sc-option.selected {
      border-color: var(--sc-sage);
      background: var(--sc-sage-faint);
    }
    .sc-option-radio {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      border: 2px solid #C4C0B8;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      transition: all 0.2s ease;
    }
    .sc-option.selected .sc-option-radio {
      border-color: var(--sc-sage);
      background: var(--sc-sage);
    }
    .sc-option-radio .check-svg {
      display: none;
    }
    .sc-option.selected .sc-option-radio .check-svg {
      display: block;
    }
    .sc-option-text {
      font-size: 15px;
      font-weight: 600;
      color: var(--sc-dark);
    }
    .sc-option-sub {
      font-size: 13px;
      color: var(--sc-muted);
      margin-top: 2px;
    }

    /* Checkbox cards (multi select) */
    .sc-check {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 13px 16px;
      width: 100%;
      border: 1.5px solid var(--sc-border);
      border-radius: 10px;
      background: var(--sc-white);
      cursor: pointer;
      transition: all 0.2s ease;
      text-align: left;
      outline: none;
      font-family: var(--sc-sans);
      margin-bottom: 10px;
      box-sizing: border-box;
    }
    .sc-check:hover {
      border-color: var(--sc-sage-light);
    }
    .sc-check.selected {
      border-color: var(--sc-sage);
      background: var(--sc-sage-faint);
    }
    .sc-check-box {
      width: 20px;
      height: 20px;
      border-radius: 5px;
      border: 2px solid #C4C0B8;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      transition: all 0.2s ease;
    }
    .sc-check.selected .sc-check-box {
      border-color: var(--sc-sage);
      background: var(--sc-sage);
    }
    .sc-check-box .check-svg {
      display: none;
    }
    .sc-check.selected .sc-check-box .check-svg {
      display: block;
    }
    .sc-check-text {
      font-size: 15px;
      font-weight: 500;
      color: var(--sc-dark);
    }

    /* Buttons */
    .sc-btn {
      display: block;
      width: 100%;
      padding: 15px 24px;
      background: var(--sc-sage);
      color: var(--sc-white);
      border: none;
      border-radius: 10px;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      font-family: var(--sc-sans);
      letter-spacing: 0.01em;
      transition: all 0.25s ease;
      margin-top: 24px;
      box-sizing: border-box;
      text-align: center;
      text-decoration: none;
    }
    .sc-btn:hover {
      background: var(--sc-sage-dark);
    }
    .sc-btn:disabled {
      background: #C4C0B8;
      cursor: not-allowed;
    }
    .sc-btn-back {
      background: none;
      border: none;
      color: var(--sc-muted);
      cursor: pointer;
      font-size: 14px;
      font-family: var(--sc-sans);
      padding: 8px 0;
      display: flex;
      align-items: center;
      gap: 4px;
    }

    /* Results cards */
    .sc-card {
      background: var(--sc-white);
      border-radius: 14px;
      padding: 24px;
      border: 1px solid var(--sc-border);
      margin-bottom: 16px;
    }
    .sc-card-dark {
      background: var(--sc-dark);
      border-radius: 14px;
      padding: 28px;
      margin-bottom: 16px;
      color: var(--sc-white);
    }
    .sc-card-warn {
      background: #FFFBF5;
      border-radius: 14px;
      padding: 24px;
      border: 1px solid #F0E4CF;
      margin-bottom: 16px;
    }
    .sc-card-success {
      background: var(--sc-sage-faint);
      border-radius: 14px;
      padding: 28px;
      border: 1.5px solid rgba(92, 122, 107, 0.2);
      margin-bottom: 16px;
      text-align: center;
    }

    /* Score ring */
    .sc-score-wrap {
      position: relative;
      width: 110px;
      height: 110px;
      margin: 0 auto 14px;
    }
    .sc-score-num {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--sc-serif);
      font-size: 34px;
      font-weight: 700;
      color: var(--sc-dark);
    }
    .sc-score-ring-bg {
      fill: none;
      stroke: var(--sc-border);
      stroke-width: 7;
    }
    .sc-score-ring-fg {
      fill: none;
      stroke: var(--sc-sage);
      stroke-width: 7;
      stroke-linecap: round;
      transform: rotate(-90deg);
      transform-origin: 55px 55px;
      transition: stroke-dasharray 1s ease;
    }

    /* Urgency badge */
    .sc-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 7px 16px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 600;
      font-family: var(--sc-sans);
    }
    .sc-badge-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
    }

    /* Benefit rows */
    .sc-benefit {
      display: flex;
      gap: 12px;
      margin-bottom: 14px;
      align-items: flex-start;
    }
    .sc-benefit-icon {
      width: 22px;
      height: 22px;
      border-radius: 6px;
      background: var(--sc-sage-faint);
      border: 1px solid rgba(92, 122, 107, 0.15);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      margin-top: 2px;
    }
    .sc-benefit-text {
      font-size: 15px;
      color: var(--sc-body);
      line-height: 1.5;
    }

    /* Risk rows */
    .sc-risk {
      display: flex;
      gap: 12px;
      margin-bottom: 12px;
      align-items: flex-start;
    }
    .sc-risk-dot {
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background: #D97706;
      flex-shrink: 0;
      margin-top: 9px;
    }
    .sc-risk-text {
      font-size: 15px;
      color: #92400E;
      line-height: 1.5;
    }

    /* Add-on rows in dark card */
    .sc-addon-row {
      display: flex;
      justify-content: space-between;
      font-size: 14px;
      opacity: 0.8;
      margin-bottom: 6px;
    }
    .sc-complex-box {
      margin-top: 16px;
      padding: 12px 16px;
      background: rgba(156, 126, 74, 0.15);
      border-radius: 10px;
      border: 1px solid rgba(156, 126, 74, 0.25);
      font-size: 14px;
      color: var(--sc-bronze-light);
      line-height: 1.5;
    }

    /* Form inputs */
    .sc-input {
      width: 100%;
      padding: 13px 16px;
      border: 1.5px solid var(--sc-border);
      border-radius: 8px;
      font-size: 15px;
      font-family: var(--sc-sans);
      margin-bottom: 10px;
      outline: none;
      box-sizing: border-box;
      background: var(--sc-cream);
      transition: border-color 0.2s;
      color: var(--sc-dark);
    }
    .sc-input:focus {
      border-color: var(--sc-sage);
    }
    .sc-input::placeholder {
      color: #B0AAA0;
    }

    /* Utility */
    .sc-center { text-align: center; }
    .sc-mt-0 { margin-top: 0; }
    .sc-mb-0 { margin-bottom: 0; }
    .sc-divider {
      border: none;
      border-top: 1px solid var(--sc-border);
      margin: 28px 0 20px;
    }
    .sc-fine-print {
      font-size: 11px;
      color: var(--sc-muted);
      text-align: center;
      line-height: 1.7;
      opacity: 0.8;
    }
    .sc-link {
      color: var(--sc-sage);
      font-weight: 600;
      text-decoration: none;
    }
    .sc-link:hover {
      text-decoration: underline;
    }
    .sc-pricing-label {
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      opacity: 0.55;
      margin: 0 0 4px;
    }
    .sc-pricing-amount {
      font-family: var(--sc-serif);
      font-size: 32px;
      font-weight: 700;
      margin: 0 0 4px;
    }
    .sc-pricing-note {
      font-size: 13px;
      opacity: 0.5;
      margin: 0 0 18px;
    }
    .sc-addons-label {
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      opacity: 0.45;
      margin: 0 0 10px;
    }
    .sc-results-heading {
      font-family: var(--sc-serif);
      font-size: 20px;
      font-weight: 600;
      color: var(--sc-dark);
      margin: 0 0 18px;
    }
    .sc-warn-header {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 16px;
    }
    .sc-warn-heading {
      font-family: var(--sc-serif);
      font-size: 20px;
      font-weight: 600;
      color: #78350F;
      margin: 0;
    }
    .sc-toolkit-heading {
      font-family: var(--sc-serif);
      font-size: 22px;
      font-weight: 600;
      color: var(--sc-dark);
      margin: 0 0 6px;
    }
    .sc-success-icon {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: var(--sc-sage);
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 14px;
    }
  </style>
</head>
<body style="background: var(--sc-cream); margin: 0;">
  <div class="sc-wrap" id="scorecard">

    <!-- Header -->
    <div class="sc-header">
      <div class="sc-header-left">
        <div class="sc-header-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <span class="sc-header-title">Mesa Estate Planning</span>
      </div>
      <span class="sc-header-step" id="stepIndicator"></span>
    </div>

    <!-- Progress -->
    <div class="sc-progress" id="progressBar" style="display:none;">
      <div class="sc-progress-seg" data-seg="0"></div>
      <div class="sc-progress-seg" data-seg="1"></div>
      <div class="sc-progress-seg" data-seg="2"></div>
      <div class="sc-progress-seg" data-seg="3"></div>
    </div>

    <div class="sc-content">

      <!-- ═══ Screen 0: Welcome ═══ -->
      <div class="sc-screen active" data-screen="0">
        <div class="sc-center" style="padding-top: 48px;">
          <div style="width:72px;height:72px;border-radius:18px;background:var(--sc-sage);display:flex;align-items:center;justify-content:center;margin:0 auto 28px;">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
          </div>
          <h1 class="sc-heading sc-heading-lg sc-center">Your Estate Plan<br>Scorecard</h1>
          <p style="font-size:16px;color:var(--sc-body);line-height:1.6;margin:14px auto 8px;max-width:340px;">
            Answer a few quick questions to discover what estate plan fits your life — and what it might cost.
          </p>
          <p style="font-size:14px;color:var(--sc-muted);margin:0 0 36px;">
            About 2 minutes · Free · No login required
          </p>
          <button class="sc-btn" onclick="goTo(1)">Get Started</button>
          <p class="sc-fine-print" style="margin-top:20px;">Mesa Estate Planning PLLC · Mesa, Arizona</p>
        </div>
      </div>

      <!-- ═══ Screen 1: Plan Status ═══ -->
      <div class="sc-screen" data-screen="1">
        <button class="sc-btn-back" onclick="goTo(0)">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
          Back
        </button>
        <h2 class="sc-heading">Do you currently have an estate plan?</h2>
        <p class="sc-subtext">This helps us understand your starting point.</p>

        <button class="sc-option" data-group="planStatus" data-value="none" onclick="selectOption(this)">
          <div class="sc-option-radio"><svg class="check-svg" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div>
          <div><div class="sc-option-text">No estate plan at all</div><div class="sc-option-sub">No will, no trust, no documents</div></div>
        </button>
        <button class="sc-option" data-group="planStatus" data-value="will_only" onclick="selectOption(this)">
          <div class="sc-option-radio"><svg class="check-svg" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div>
          <div><div class="sc-option-text">I have a will, but no trust</div><div class="sc-option-sub">Will but no trust</div></div>
        </button>
        <button class="sc-option" data-group="planStatus" data-value="outdated" onclick="selectOption(this)">
          <div class="sc-option-radio"><svg class="check-svg" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div>
          <div><div class="sc-option-text">I have a plan, but it's outdated</div><div class="sc-option-sub">Created 3+ years ago or before a major life change</div></div>
        </button>
        <button class="sc-option" data-group="planStatus" data-value="current" onclick="selectOption(this)">
          <div class="sc-option-radio"><svg class="check-svg" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div>
          <div><div class="sc-option-text">I have a current estate plan</div><div class="sc-option-sub">Recently updated and reviewed</div></div>
        </button>

        <button class="sc-btn" id="btn1" disabled onclick="goTo(2)">Continue</button>
      </div>

      <!-- ═══ Screen 2: Family ═══ -->
      <div class="sc-screen" data-screen="2">
        <button class="sc-btn-back" onclick="goTo(1)">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
          Back
        </button>
        <h2 class="sc-heading">Tell us about your family</h2>
        <p class="sc-subtext">Your family situation shapes what protections you need.</p>

        <span class="sc-label">Marital Status</span>
        <button class="sc-option" data-group="maritalStatus" data-value="single" onclick="selectOption(this)">
          <div class="sc-option-radio"><svg class="check-svg" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div>
          <div><div class="sc-option-text">Single</div></div>
        </button>
        <button class="sc-option" data-group="maritalStatus" data-value="married" onclick="selectOption(this)">
          <div class="sc-option-radio"><svg class="check-svg" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div>
          <div><div class="sc-option-text">Married</div></div>
        </button>
        <button class="sc-option" data-group="maritalStatus" data-value="partner" onclick="selectOption(this)">
          <div class="sc-option-radio"><svg class="check-svg" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div>
          <div><div class="sc-option-text">Domestic Partner</div></div>
        </button>

        <span class="sc-label" style="margin-top:24px;">Children</span>
        <button class="sc-check" data-field="hasMinorChildren" onclick="toggleCheck(this)">
          <div class="sc-check-box"><svg class="check-svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div>
          <span class="sc-check-text">I have minor children (under 18)</span>
        </button>
        <button class="sc-check" data-field="hasAdultChildren" onclick="toggleCheck(this)">
          <div class="sc-check-box"><svg class="check-svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div>
          <span class="sc-check-text">I have adult children</span>
        </button>
        <button class="sc-check" data-field="blendedFamily" onclick="toggleCheck(this)">
          <div class="sc-check-box"><svg class="check-svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div>
          <span class="sc-check-text">Blended family (children from prior relationships)</span>
        </button>

        <button class="sc-btn" id="btn2" disabled onclick="goTo(3)">Continue</button>
      </div>

      <!-- ═══ Screen 3: Assets ═══ -->
      <div class="sc-screen" data-screen="3">
        <button class="sc-btn-back" onclick="goTo(2)">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
