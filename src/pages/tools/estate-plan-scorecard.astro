        </button>
        <h2 class="sc-heading">What matters most to you?</h2>
        <p class="sc-subtext">Select all that apply. This shapes your personalized recommendation.</p>

        <button class="sc-check" data-field="pri_protect_kids" onclick="toggleCheck(this)">
          <div class="sc-check-box"><svg class="check-svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div>
          <span class="sc-check-text">Protecting my kids if something happens to me</span>
        </button>
        <button class="sc-check" data-field="pri_avoid_probate" onclick="toggleCheck(this)">
          <div class="sc-check-box"><svg class="check-svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div>
          <span class="sc-check-text">Avoiding probate</span>
        </button>
        <button class="sc-check" data-field="pri_asset_protection" onclick="toggleCheck(this)">
          <div class="sc-check-box"><svg class="check-svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div>
          <span class="sc-check-text">Asset protection from lawsuits or creditors</span>
        </button>
        <button class="sc-check" data-field="pri_tax_planning" onclick="toggleCheck(this)">
          <div class="sc-check-box"><svg class="check-svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div>
          <span class="sc-check-text">Minimizing estate taxes</span>
        </button>
        <button class="sc-check" data-field="pri_business_succession" onclick="toggleCheck(this)">
          <div class="sc-check-box"><svg class="check-svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div>
          <span class="sc-check-text">Business succession planning</span>
        </button>
        <button class="sc-check" data-field="pri_charitable" onclick="toggleCheck(this)">
          <div class="sc-check-box"><svg class="check-svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div>
          <span class="sc-check-text">Charitable giving</span>
        </button>
        <button class="sc-check" data-field="pri_special_needs" onclick="toggleCheck(this)">
          <div class="sc-check-box"><svg class="check-svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div>
          <span class="sc-check-text">Special needs planning for a loved one</span>
        </button>
        <button class="sc-check" data-field="pri_pet_care" onclick="toggleCheck(this)">
          <div class="sc-check-box"><svg class="check-svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div>
          <span class="sc-check-text">Pet care planning</span>
        </button>

        <button class="sc-btn" id="btn4" disabled onclick="showResults()">See My Results</button>
      </div>

      <!-- ═══ Screen 5: Results ═══ -->
      <div class="sc-screen" data-screen="5">
        <button class="sc-btn-back" onclick="goTo(4)">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
          Back
        </button>

        <div class="sc-center" style="margin-bottom:28px;">
          <h2 class="sc-heading" style="font-size:28px;">Your Estate Plan Profile</h2>
          <div id="urgencyBadge"></div>
        </div>

        <!-- Score -->
        <div class="sc-card sc-center">
          <div class="sc-score-wrap">
            <svg width="110" height="110" viewBox="0 0 110 110">
              <circle class="sc-score-ring-bg" cx="55" cy="55" r="48"/>
              <circle class="sc-score-ring-fg" id="scoreRing" cx="55" cy="55" r="48" stroke-dasharray="0 301.6"/>
            </svg>
            <div class="sc-score-num" id="scoreNum">0</div>
          </div>
          <p style="font-size:14px;color:var(--sc-muted);margin:0;">Planning Need Score (out of 10)</p>
        </div>

        <!-- Pricing -->
        <div class="sc-card-dark" id="pricingCard"></div>

        <!-- Benefits -->
        <div class="sc-card" id="benefitsCard"></div>

        <!-- Risks -->
        <div id="risksCard"></div>

        <!-- Lead capture -->
        <div id="leadCapture">
          <div class="sc-card" style="padding:28px;">
            <h3 class="sc-toolkit-heading">Get Your Free Estate Planning Toolkit</h3>
            <p style="font-size:14px;color:var(--sc-muted);margin:0 0 22px;line-height:1.6;">
              We'll send you a personalized checklist, an asset protection case study, and a free Parental Power of Attorney form — no strings attached.
            </p>
            <input class="sc-input" type="text" id="inputName" placeholder="Full Name" />
            <input class="sc-input" type="email" id="inputEmail" placeholder="Email Address" />
            <input class="sc-input" type="tel" id="inputPhone" placeholder="Phone Number" />
            <button class="sc-btn sc-mt-0" style="margin-top:14px;" id="submitBtn" onclick="submitLead()">Send My Free Tools</button>
            <p class="sc-fine-print" style="margin-top:10px;">We respect your privacy. No spam, ever.</p>
          </div>
        </div>

        <!-- Success (hidden initially) -->
        <div id="leadSuccess" style="display:none;">
          <div class="sc-card-success">
            <div class="sc-success-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <h3 class="sc-toolkit-heading">You're all set.</h3>
            <p style="font-size:15px;color:var(--sc-body);line-height:1.5;">
              Check your email for your free estate planning toolkit. In the meantime, book your free consultation below.
            </p>
          </div>
        </div>

        <!-- CTA -->
        <a class="sc-btn" href="https://cal.com/mckay-tucker-6xuf6e/free-30-minute-estate-plan-consultation" target="_blank" rel="noopener noreferrer" style="display:block;">
          Book Your Free 30-Minute Consultation
        </a>
        <div class="sc-center" style="margin-top:16px;">
          <a href="tel:4802695737" class="sc-link" style="font-size:15px;">Or call (480) 269-5737</a>
        </div>

        <hr class="sc-divider" />
        <p class="sc-fine-print">
          This tool provides general estimates for informational purposes only and does not constitute legal advice.
          Fees are confirmed after consultation. Mesa Estate Planning PLLC · 48 N Macdonald, Mesa, AZ 85201.
        </p>
      </div>
    </div>
  </div>

  <script is:inline>
    // ── State ──
    const state = {
      planStatus: null,
      maritalStatus: null,
      hasMinorChildren: false,
      hasAdultChildren: false,
      blendedFamily: false,
      assetRange: null,
      additionalProperty: false,
      ownsBusiness: false,
      priorities: [],
    };

    // ── Pricing data ──
    const PRICING = {
      coreSingle: 2300,
      coreMarried: 2800,
      addOns: {
        blendedFamily: [1000, 3000],
        additionalDeed: [250, 350],
        assetProtection: [3500, 5500],
        specialNeeds: [3000, 5000],
        petTrust: [350, 500],
      },
    };

    // ── Navigation ──
    function goTo(n) {
      document.querySelectorAll('.sc-screen').forEach(s => s.classList.remove('active'));
      const target = document.querySelector(`[data-screen="${n}"]`);
      if (target) target.classList.add('active');
      // Progress bar
      const pb = document.getElementById('progressBar');
      const si = document.getElementById('stepIndicator');
      if (n > 0 && n < 5) {
        pb.style.display = 'flex';
        si.textContent = `Step ${n} of 4`;
        pb.querySelectorAll('.sc-progress-seg').forEach(seg => {
          seg.classList.toggle('filled', parseInt(seg.dataset.seg) <= n - 1);
        });
      } else {
        pb.style.display = 'none';
        si.textContent = '';
      }
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // ── Single-select options ──
    function selectOption(el) {
      const group = el.dataset.group;
      const value = el.dataset.value;
      state[group] = value;
      // Update UI
      document.querySelectorAll(`[data-group="${group}"]`).forEach(btn => btn.classList.remove('selected'));
      el.classList.add('selected');
      updateButtons();
    }

    // ── Multi-select checkboxes ──
    function toggleCheck(el) {
      const field = el.dataset.field;
      if (field.startsWith('pri_')) {
        const pri = field.replace('pri_', '');
        const idx = state.priorities.indexOf(pri);
        if (idx >= 0) state.priorities.splice(idx, 1);
        else state.priorities.push(pri);
      } else {
        state[field] = !state[field];
      }
      el.classList.toggle('selected');
      updateButtons();
    }

    // ── Button enable/disable ──
    function updateButtons() {
      const btn1 = document.getElementById('btn1');
      const btn2 = document.getElementById('btn2');
      const btn3 = document.getElementById('btn3');
      const btn4 = document.getElementById('btn4');
      if (btn1) btn1.disabled = !state.planStatus;
      if (btn2) btn2.disabled = !state.maritalStatus;
      if (btn3) btn3.disabled = !state.assetRange;
      if (btn4) btn4.disabled = state.priorities.length === 0;
    }

    // ── Lead Score ──
    function computeLeadScore() {
      let s = 0;
      if (state.planStatus === 'none') s += 3;
      else if (state.planStatus === 'will_only') s += 2.5;
      else if (state.planStatus === 'outdated') s += 2;
      else if (state.planStatus === 'current') s += 0.5;
      if (state.maritalStatus === 'married' || state.maritalStatus === 'partner') s += 0.5;
      if (state.hasMinorChildren) s += 1.5;
      if (state.blendedFamily) s += 0.5;
      const a = { under500k: 0.5, '500k_1m': 1, '1m_3m': 1.5, '3m_5m': 2, '5m_plus': 2 };
      s += a[state.assetRange] || 0;
      if (state.ownsBusiness) s += 1.5;
      if (state.additionalProperty) s += 0.5;
      return Math.min(10, Math.round(s * 10) / 10);
    }

    // ── Recommendation Engine ──
    function getRecommendation() {
      const isMarried = state.maritalStatus === 'married' || state.maritalStatus === 'partner';
      const basePrice = isMarried ? PRICING.coreMarried : PRICING.coreSingle;
      let lowAdd = 0, highAdd = 0;
      const addOns = [];
      const benefits = [];
      const risks = [];
      let isComplex = false;

      benefits.push('Revocable Living Trust — avoids Arizona probate entirely');
      benefits.push('Pour-over will as a safety net for unfunded assets');
      benefits.push('Financial & Healthcare Powers of Attorney');
      benefits.push('Deed transfer for your primary residence into the trust');

      if (state.planStatus === 'none' || state.planStatus === 'will_only') {
        risks.push('Without a trust, your family faces Arizona probate — typically 6–12 months and thousands in court costs');
      }
      if (state.planStatus === 'outdated') {
        risks.push('An outdated plan may not reflect current Arizona law or your current wishes — and could cause unintended distributions');
      }
      if (state.blendedFamily) {
        addOns.push({ name: 'Blended Family Provisions', range: PRICING.addOns.blendedFamily });
        lowAdd += 1000; highAdd += 3000;
        benefits.push('Blended family protections — separate vs. marital property, provisions for children from prior relationships');
        risks.push('Without blended family provisions, Arizona community property law could leave children from a prior relationship unprotected');
      }
      if (state.hasMinorChildren) {
        benefits.push('Guardian nomination for your minor children — you choose, not a judge');
        risks.push('Without a guardian designation, an Arizona court decides who raises your children');
      }
      if (state.additionalProperty) {
        addOns.push({ name: 'Additional Deed Transfer & Recording', range: PRICING.addOns.additionalDeed });
        lowAdd += 250; highAdd += 350;
      }
      if (state.ownsBusiness) {
        isComplex = true;
        benefits.push('Business succession planning — protect your company and your family\'s income');
      }
      if (state.priorities.includes('asset_protection') && ['1m_3m', '3m_5m', '5m_plus'].includes(state.assetRange)) {
        addOns.push({ name: 'Asset Protection Trust', range: PRICING.addOns.assetProtection });
        lowAdd += 3500; highAdd += 5500;
        benefits.push('Asset protection trust — shields wealth from lawsuits and creditors');
      }
      if (state.priorities.includes('tax_planning') && ['3m_5m', '5m_plus'].includes(state.assetRange)) {
        isComplex = true;
        benefits.push('Estate tax reduction strategies — potentially saving your heirs hundreds of thousands');
      }
      if (state.priorities.includes('charitable')) {
        isComplex = true;
        benefits.push('Charitable planning — tax-efficient giving through CRTs, CLTs, or donor-advised funds');
      }
      if (state.priorities.includes('special_needs')) {
        addOns.push({ name: 'Special Needs Trust (Third-Party)', range: PRICING.addOns.specialNeeds });
        lowAdd += 3000; highAdd += 5000;
        benefits.push('Special Needs Trust — provides for a loved one without jeopardizing their benefits');
      }
      if (state.priorities.includes('pet_care')) {
        addOns.push({ name: 'Pet Trust', range: PRICING.addOns.petTrust });
        lowAdd += 350; highAdd += 500;
        benefits.push('Pet trust — legally enforceable care plan for your animals');
      }
      if (state.priorities.includes('business_succession') && !state.ownsBusiness) {
        isComplex = true;
      }

      const urgency = state.planStatus === 'none' && state.hasMinorChildren ? 'critical'
        : state.planStatus === 'none' ? 'high'
        : state.planStatus === 'will_only' || state.planStatus === 'outdated' ? 'moderate'
        : 'low';

      return {
        basePrice,
        lowEstimate: basePrice + lowAdd,
        highEstimate: addOns.length > 0 ? basePrice + highAdd : basePrice,
        addOns, benefits: benefits.slice(0, 6), risks: risks.slice(0, 3),
        isComplex, urgency, isMarried,
      };
    }

    // ── Render Results ──
    function showResults() {
      const score = computeLeadScore();
      const rec = getRecommendation();

      // Score ring
      const circumference = 301.6;
      document.getElementById('scoreRing').setAttribute('stroke-dasharray', `${(score / 10) * circumference} ${circumference}`);
      document.getElementById('scoreNum').textContent = score;

      // Urgency badge
      const badges = {
        critical: { bg: '#FEF2F2', border: '#FECACA', color: '#B91C1C', text: 'Critical Priority' },
        high: { bg: '#FFF7ED', border: '#FED7AA', color: '#C2410C', text: 'High Priority' },
        moderate: { bg: '#FFFBEB', border: '#FDE68A', color: '#B45309', text: 'Moderate Priority' },
        low: { bg: '#F0FDF4', border: '#BBF7D0', color: '#4A6557', text: 'Up to Date' },
      };
      const b = badges[rec.urgency];
      document.getElementById('urgencyBadge').innerHTML =
        `<div class="sc-badge" style="background:${b.bg};border:1px solid ${b.border};">` +
        `<div class="sc-badge-dot" style="background:${b.color};"></div>` +
        `<span style="color:${b.color};">${b.text}</span></div>`;

      // Pricing card
      let pHtml = `<p class="sc-pricing-label">Estimated Fee Range</p>`;
      pHtml += `<div class="sc-pricing-amount">From $${rec.lowEstimate.toLocaleString()}</div>`;
      pHtml += `<p class="sc-pricing-note" style="opacity:0.7;line-height:1.5;">Every plan is tailored. Your actual fee may be higher or lower depending on your situation. You'll receive an exact quote at your free 30-minute consultation before you commit to anything.</p>`;
      if (rec.addOns.length > 0) {
        pHtml += `<div style="border-top:1px solid rgba(255,255,255,0.12);padding-top:14px;">`;
        pHtml += `<p class="sc-addons-label">Estimated add-ons based on your answers</p>`;
        rec.addOns.forEach(a => {
          pHtml += `<div class="sc-addon-row"><span>${a.name}</span><span>$${a.range[0].toLocaleString()} – $${a.range[1].toLocaleString()}</span></div>`;
        });
        pHtml += `</div>`;
      }
      if (rec.isComplex) {
        pHtml += `<div class="sc-complex-box">Your situation also involves <strong>Complex Estate Planning</strong> (business succession, tax strategies, etc.) — quoted after consultation.</div>`;
      }
      document.getElementById('pricingCard').innerHTML = pHtml;

      // Benefits
      let bHtml = `<h3 class="sc-results-heading">Protections You'd Unlock</h3>`;
      rec.benefits.forEach(ben => {
        bHtml += `<div class="sc-benefit">` +
          `<div class="sc-benefit-icon"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--sc-sage)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div>` +
          `<span class="sc-benefit-text">${ben}</span></div>`;
      });
      document.getElementById('benefitsCard').innerHTML = bHtml;

      // Risks
      if (rec.risks.length > 0) {
        let rHtml = `<div class="sc-card-warn"><div class="sc-warn-header">` +
          `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#B45309" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>` +
          `<h3 class="sc-warn-heading">What's at Risk</h3></div>`;
        rec.risks.forEach(r => {
          rHtml += `<div class="sc-risk"><div class="sc-risk-dot"></div><span class="sc-risk-text">${r}</span></div>`;
        });
        rHtml += `</div>`;
        document.getElementById('risksCard').innerHTML = rHtml;
      } else {
        document.getElementById('risksCard').innerHTML = '';
      }

      // Store recommendation for form submission
      window._rec = rec;
      window._score = score;

      goTo(5);
    }

    // ── Form Submission ──
    async function submitLead() {
      const name = document.getElementById('inputName').value.trim();
      const email = document.getElementById('inputEmail').value.trim();
      const phone = document.getElementById('inputPhone').value.trim();
      if (!name || !email || !phone) return;

      const btn = document.getElementById('submitBtn');
      btn.disabled = true;
      btn.textContent = 'Sending...';

      const rec = window._rec;
      const payload = {
        name, email, phone,
        source: 'Estate Planning Scorecard',
        leadScore: window._score,
        planStatus: state.planStatus,
        maritalStatus: state.maritalStatus,
        hasMinorChildren: state.hasMinorChildren,
        hasAdultChildren: state.hasAdultChildren,
        blendedFamily: state.blendedFamily,
        assetRange: state.assetRange,
        additionalProperty: state.additionalProperty,
        ownsBusiness: state.ownsBusiness,
        priorities: state.priorities.join(', '),
        estimatedFeeRange: rec ? `$${rec.lowEstimate.toLocaleString()} – $${rec.highEstimate.toLocaleString()}` : '',
        urgency: rec?.urgency || '',
        isComplex: rec?.isComplex ? 'Yes' : 'No',
      };

      try {
        // Replace with your actual Google Apps Script web app URL
        await fetch('YOUR_APPS_SCRIPT_URL_HERE', {
          method: 'POST',
          mode: 'no-cors',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
      } catch (e) {
        console.error(e);
      }

      document.getElementById('leadCapture').style.display = 'none';
      document.getElementById('leadSuccess').style.display = 'block';
    }

    // Expose functions to onclick handlers
    window.goTo = goTo;
    window.selectOption = selectOption;
