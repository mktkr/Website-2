---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Contact Us | Free Estate Planning Consultation | Mesa Estate Planning"
  description="Book a free 30-minute estate planning consultation with Mesa Estate Planning. Located at 48 N Macdonald, Mesa, AZ 85201. Call (480) 269-5737 or submit our contact form."
  keywords="mesa estate planning consultation, free estate planning consultation mesa az, estate planning attorney mesa"
>
  <section class="service-hero">
    <div class="service-hero-content">
      <div class="service-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="bc-sep">/</span>
        <span class="bc-current">Contact</span>
      </div>
      <h1 class="hero-h1" style="opacity:1;animation:none;">Let's talk about <em>your plan</em></h1>
      <p class="hero-body" style="opacity:1;animation:none;">Your first consultation is completely free. We'll learn about your situation and tell you exactly what you need — no pressure, no sales pitch.</p>
    </div>
  </section>

  <section class="contact" id="contact">
    <div class="contact-layout">
      <div class="contact-left">
        <div class="contact-details">
          <div class="contact-detail"><div class="contact-icon">&#128205;</div><div><strong>Office</strong><span>48 N Macdonald, Mesa, AZ 85201</span></div></div>
          <div class="contact-detail"><div class="contact-icon">&#128222;</div><div><strong>Phone</strong><span><a href="tel:4802695737">(480) 269-5737</a></span></div></div>
          <div class="contact-detail"><div class="contact-icon">&#9993;&#65039;</div><div><strong>Email</strong><span><a href="mailto:info@mesaestateplan.com">info@mesaestateplan.com</a></span></div></div>
          <div class="contact-detail"><div class="contact-icon">&#128336;</div><div><strong>Hours</strong><span>Mon–Fri, 8am–5pm &middot; Virtual available</span></div></div>
        </div>

        <div class="schedule-card">
          <h2>Ready to schedule?</h2>
          <p>Pick a time that works for you. Consultations are 30 minutes, free, and held over Google Meet.</p>
          <a href="https://calendar.app.google/utThHtEGnYzLCZWh7" class="btn-schedule" target="_blank" rel="noopener">Book a Free Consultation &#8594;</a>
        </div>

        <div class="expect-section">
          <h3>What to Expect</h3>
          <p>We'll ask about your family, your assets, and what's prompting you to look at estate planning now. By the end, you'll know whether you need a trust or a will, what other documents belong in your plan, and roughly what the work involves.</p>
          <p>There's no obligation to proceed, and we'll never pressure you. If we're not the right fit, we'll tell you.</p>
          <p>Want to learn more about how we work before scheduling? Read about <a href="/our-process">our process</a>.</p>
        </div>
      </div>

      <div class="contact-form-wrap">
        <h3>Not ready to book? Send us a message.</h3>
        <p>Tell us about your situation and we'll reach out within one business day.</p>
        <form id="contact-form">
          <div class="form-row">
            <div class="form-group"><label for="firstName">First Name</label><input type="text" id="firstName" name="firstName" placeholder="First name" required></div>
            <div class="form-group"><label for="lastName">Last Name</label><input type="text" id="lastName" name="lastName" placeholder="Last name" required></div>
          </div>
          <div class="form-row">
            <div class="form-group"><label for="email">Email</label><input type="email" id="email" name="email" placeholder="you@email.com" required></div>
            <div class="form-group"><label for="phone">Phone</label><input type="tel" id="phone" name="phone" placeholder="(480) 555-0000"></div>
          </div>
          <div class="form-group"><label for="contactType">I am a...</label><select id="contactType" name="contactType"><option value="">Select...</option><option>Individual / Family</option><option>Business Owner</option><option>Financial Planner / RIA</option><option>CPA / Tax Professional</option><option>Insurance Agent</option><option>Attorney (referral)</option></select></div>
          <div class="form-group"><label for="service">Service Interested In</label><select id="service" name="service"><option value="">Select a service...</option><option>Wills &amp; Trusts</option><option>Powers of Attorney</option><option>Business Succession Planning</option><option>Asset Protection</option><option>Estate Tax Planning</option><option>Not sure yet &#8212; I need guidance</option></select></div>
          <div class="form-group"><label for="message">Tell us about your situation (optional)</label><textarea id="message" name="message" placeholder="e.g. Married with two kids, own a home and small business, need a trust..."></textarea></div>
          <button type="submit" class="form-submit" id="submit-btn">Send Message</button>
          <div id="form-status" style="margin-top:12px;display:none;"></div>
        </form>
        <p class="form-disclaimer">By submitting this form, you are not creating an attorney-client relationship. All consultations are confidential.</p>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('contact-form');
    const submitBtn = document.getElementById('submit-btn');
    const formStatus = document.getElementById('form-status');
    const APPS_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbzx4nk6kEyK2QtePxhfQrvZA5JtGYwBhD_Owe3xXzj2fIbVs3Lc9hfrmLtuELtrjX0U2Q/exec';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';
      formStatus.style.display = 'none';

      const payload = {
        firstName: document.getElementById('firstName').value,
        lastName: document.getElementById('lastName').value,
        email: document.getElementById('email').value,
        phone: document.getElementById('phone').value,
        contactType: document.getElementById('contactType').value,
        service: document.getElementById('service').value,
        message: document.getElementById('message').value,
        source: 'Website Form'
      };

      try {
        const res = await fetch(APPS_SCRIPT_URL, {
          method: 'POST',
          mode: 'no-cors',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        formStatus.style.display = 'block';
        formStatus.style.color = '#5C7A6B';
        formStatus.innerHTML = '&#10003; Thanks! We received your message and will be in touch shortly. You can also <a href="https://calendar.app.google/utThHtEGnYzLCZWh7" target="_blank" rel="noopener" style="color:#5C7A6B;text-decoration:underline;">schedule a consultation now</a>.';
        form.reset();
      } catch (err) {
        formStatus.style.display = 'block';
        formStatus.style.color = '#c0392b';
        formStatus.textContent = 'Something went wrong. Please call us at (480) 269-5737 or email info@mesaestateplan.com.';
      }
      submitBtn.disabled = false;
      submitBtn.textContent = 'Send Message';
    });
  </script>
</BaseLayout>
