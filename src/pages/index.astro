---
import BaseLayout from '../../layouts/BaseLayout.astro';
const stages = [
  { num: '01', title: 'Just Starting Out', desc: 'You\'re 18+ and on your own. A healthcare directive and financial power of attorney are the minimum — and most people don\'t have either.', href: '/life-stages/just-starting-out', icon: '🎓' },
  { num: '02', title: 'Newly Married', desc: 'Arizona is a community property state. Marriage changes how your assets are owned, who inherits them, and what happens if you don\'t plan.', href: '/life-stages/newly-married', icon: '💍' },
  { num: '03', title: 'Growing Family', desc: 'Kids change everything — including who needs to be protected. Guardianship, trusts for minors, and life insurance planning start here.', href: '/life-stages/growing-family', icon: '👶' },
  { num: '04', title: 'Blended Families', desc: 'Stepchildren, prior marriages, and separate property create complexity that default Arizona law doesn\'t handle well. Planning is essential.', href: '/life-stages/blended-families', icon: '🏠' },
  { num: '05', title: 'Peak Earning Years', desc: 'You\'re building real wealth — a business, investments, equity. Asset protection, tax planning, and succession strategies matter now.', href: '/life-stages/peak-earning-years', icon: '📈' },
  { num: '06', title: 'Divorce or Loss', desc: 'A major life change means your entire plan needs to be reviewed. Beneficiary designations, agents, and trustees may all need to change.', href: '/life-stages/divorce-or-loss', icon: '🔄' },
  { num: '07', title: 'Approaching Retirement', desc: 'Healthcare directives, beneficiary deed reviews, long-term care planning, and retirement account designations — the pre-retirement checklist.', href: '/life-stages/approaching-retirement', icon: '🌅' },
  { num: '08', title: 'Legacy & Retirement', desc: 'Charitable planning, dynasty trusts, annual reviews, and the strategies that define what you leave behind and how it\'s remembered.', href: '/life-stages/legacy-and-retirement', icon: '🌳' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "When should I start estate planning?", "acceptedAnswer": { "@type": "Answer", "text": "At 18, you should have a healthcare directive and financial power of attorney at minimum. If you have assets, dependents, or a spouse, you need a more comprehensive plan. The right time is always now — the cost of not having a plan is always higher than the cost of having one." }},
    { "@type": "Question", "name": "How often should I update my estate plan?", "acceptedAnswer": { "@type": "Answer", "text": "Review every 3-5 years as a baseline, and immediately after any major life event: marriage, divorce, birth of a child, death of a named agent or beneficiary, significant change in assets, or a move to Arizona from another state." }},
    { "@type": "Question", "name": "Does my estate plan from another state work in Arizona?", "acceptedAnswer": { "@type": "Answer", "text": "It may be legally valid, but it likely isn't optimized for Arizona law. Arizona has specific rules around community property, trust execution, powers of attorney, healthcare directives, and beneficiary deeds that differ from other states. An Arizona attorney should review any out-of-state plan." }},
  ]
};
---
<BaseLayout
  title="Life Stages | Estate Planning for Every Chapter | Mesa Estate Planning"
  description="Estate planning looks different at every stage of life. Whether you're just starting out, raising a family, building wealth, or planning your legacy — find what matters most right now. Free consultation."
  keywords="estate planning life stages, when to start estate planning, estate planning young adults arizona, estate planning retirement arizona, estate planning newlyweds, blended family estate planning"
  schema={faqSchema}
>
  <section class="services-index-hero">
    <div class="services-index-hero-content">
      <div class="hero-eyebrow" style="opacity:1;animation:none;">Life Stages</div>
      <h1 class="hero-h1" style="opacity:1;animation:none;">Your plan should fit <em>your life</em> — not someone else's</h1>
      <p class="hero-body" style="opacity:1;animation:none;">A 25-year-old single professional, a couple with a new baby, and a retiree planning their legacy all need estate plans. But not the same estate plan. Find your stage. See what matters most right now.</p>
      <div class="hero-btns" style="opacity:1;animation:none;">
        <a href="/contact" class="btn-bronze">Book Free Consultation</a>
        <a href="tel:4802695737" class="btn-ghost-w">Call (480) 269-5737</a>
      </div>
    </div>
  </section>

  <!-- Timeline Visual -->
  <section class="ls-timeline-section">
    <div class="ls-timeline-track">
      {stages.map((s, i) => (
        <a href={s.href} class="ls-timeline-node">
          <span class="ls-timeline-dot">{s.num}</span>
          <span class="ls-timeline-label">{s.title}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Card Grid -->
  <section class="services-index-grid">
    <div class="services-index-section">
      <div class="services-index-label">Find Your Stage</div>
      <div class="services-card-grid ls-card-grid">
        {stages.map(s => (
          <a href={s.href} class="services-index-card ls-card">
            <div class="ls-card-num">{s.num}</div>
            <div class="services-card-icon">{s.icon}</div>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
            <span class="services-card-link">Explore this stage &rarr;</span>
          </a>
        ))}
      </div>
    </div>

    <!-- FAQ Section -->
    <div class="services-index-section" style="max-width:780px;">
      <div class="services-index-label">Common Questions</div>
      <div class="faq-section">
        <div class="faq-item">
          <button class="faq-btn" onclick="toggleFaq(this)">
            When should I start estate planning?
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer">
            <p>At 18, you should have a <a href="/services/healthcare-directive">healthcare directive</a> and <a href="/services/financial-power-of-attorney">financial power of attorney</a> at minimum. Without these, your parents can't make medical or financial decisions for you once you're a legal adult — even in an emergency. If you have assets, dependents, or a spouse, a more comprehensive plan is essential.</p>
          </div>
        </div>
        <div class="faq-item">
          <button class="faq-btn" onclick="toggleFaq(this)">
            How often should I update my estate plan?
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer">
            <p>Review every three to five years as a baseline, and immediately after any major life event: marriage, divorce, birth or adoption of a child, death of a named agent or beneficiary, significant change in assets, or a move to Arizona from another state. An outdated plan can be worse than no plan at all.</p>
          </div>
        </div>
        <div class="faq-item">
          <button class="faq-btn" onclick="toggleFaq(this)">
            Does my estate plan from another state work in Arizona?
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer">
            <p>It may be legally valid, but it likely isn't optimized for Arizona law. Arizona is a community property state with specific rules around trust execution, <a href="/services/financial-power-of-attorney">powers of attorney</a>, healthcare directives, and <a href="/glossary#arizona-beneficiary-deed">beneficiary deeds</a> that differ from other states. Any out-of-state plan should be reviewed by an Arizona attorney before you rely on it.</p>
          </div>
        </div>
        <div class="faq-item">
          <button class="faq-btn" onclick="toggleFaq(this)">
            What's the difference between "Life Stages" and "Who We Serve"?
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer">
            <p><a href="/who-we-serve">Who We Serve</a> organizes our work by who you are — a family, a business owner, a high-net-worth individual. Life Stages organizes it by where you are in life right now. Many clients find themselves in both. A business owner in their peak earning years, for example, might explore both the <a href="/who-we-serve/business-owners">Business Owners</a> page and the <a href="/life-stages/peak-earning-years">Peak Earning Years</a> page. Start wherever feels most relevant to you.</p>
          </div>
        </div>
      </div>
    </div>

    <div class="services-index-cta">
      <h2>Not sure which stage fits?</h2>
      <p>Most people are navigating more than one stage at once — and that's completely normal. Start with a free consultation and we'll build a plan around where you actually are, not where a checklist says you should be.</p>
      <a href="/contact" class="btn-bronze">Book Free Consultation</a>
    </div>
  </section>

  <script>
    function toggleFaq(btn) {
      const item = btn.closest('.faq-item');
      const isOpen = item.classList.contains('open');
      document.querySelectorAll('.faq-item.open').forEach(el => el.classList.remove('open'));
      if (!isOpen) item.classList.add('open');
    }
  </script>
</BaseLayout>
