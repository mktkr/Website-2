---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadCarousel from '../components/LeadCarousel.astro';
---

<BaseLayout
  title="Mesa Estate Planning | Wills, Trusts & Asset Protection | Mesa, AZ"
  description="Mesa estate planning attorney helping Arizona families and business owners protect assets, provide for loved ones, and preserve legacies with wills, trusts, and asset protection."
  keywords="estate planning mesa az, wills trusts mesa arizona, estate attorney mesa, probate avoidance arizona, asset protection mesa"
>

<!-- ═══════════════════════════════════
     HERO — Fullscreen video background
═══════════════════════════════════ -->
<section class="v2-hero">
  <div class="v2-hero-overlay"></div>

  <!-- Video background (replace src with your video file) -->
  <video class="v2-hero-video" autoplay muted loop playsinline poster="/images/hero-poster.png">
    <source src="/video/hero-bg.mp4" type="video/mp4">
  </video>

  <div class="v2-hero-content">
    <div class="v2-hero-eyebrow">Mesa, Arizona &middot; Estate Planning</div>
    <h1 class="v2-hero-h1">Protect what matters.<br><em>Plan what's next.</em></h1>
    <p class="v2-hero-body">We help Mesa families and business owners build estate plans that protect assets, provide for loved ones, and preserve legacies.</p>
    <a href="/contact" class="v2-hero-cta">Book Free Consultation</a>
  </div>

  <!-- Social icons — desktop only -->
  <div class="v2-hero-social">
    <div class="v2-hero-social-line"></div>
    <a href="/social" aria-label="Facebook" class="v2-social-icon">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
    </a>
    <a href="/social" aria-label="LinkedIn" class="v2-social-icon">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
    </a>
    <a href="/social" aria-label="X" class="v2-social-icon">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4l6.5 8L4 20h2l5.5-6.8L16 20h4l-6.8-8.4L20 4h-2l-5.2 6.4L8 4H4z"/></svg>
    </a>
    <a href="/social" aria-label="Instagram" class="v2-social-icon">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
    </a>
  </div>
</section>


<!-- ═══════════════════════════════════
     LEAD MAGNET CAROUSEL
═══════════════════════════════════ -->
<LeadCarousel />


<!-- ═══════════════════════════════════
     WHAT WE DO
═══════════════════════════════════ -->
<section class="v2-whatwedo">
  <div class="v2-whatwedo-inner">
    <div class="v2-whatwedo-img">
      <img src="/images/tapemeasure.png" alt="Estate planning consultation at Mesa Estate Planning" loading="lazy">
    </div>
    <div class="v2-whatwedo-text">
      <div class="v2-section-label">What We Do</div>
      <h2 class="v2-section-title">We help you build a plan that actually works.</h2>
      <p>Our first priority is understanding your situation — your family, your assets, your goals. From there, we build an estate plan that's thorough, clear, and tailored to how your life actually works. Not a template. Not a package. A plan you can explain to your family and trust to hold up when it matters.</p>
      <p>Long-term relationships built on honest conversation have been the foundation of our practice. We want to earn your trust — and keep it.</p>
      <a href="/about" class="v2-btn-outline">Get To Know Us</a>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════
     HOW WE HELP — Two service cards
═══════════════════════════════════ -->
<section class="v2-howwehelp">
  <div class="v2-howwehelp-header">
    <div class="v2-section-label">How We Help</div>
    <h2 class="v2-section-title">Estate planning built around <em>your life</em></h2>
    <p class="v2-howwehelp-sub">Our world is complex — building a plan to protect what you've built doesn't have to be.</p>
  </div>
  <div class="v2-howwehelp-cards">
    <a href="/who-we-serve/families" class="v2-help-card">
      <div class="v2-help-card-img">
        <img src="/images/lego.jpg" alt="Family estate planning" loading="lazy">
      </div>
      <h3>You &amp; Your Family</h3>
      <p>Trusts, wills, guardianship designations, healthcare directives, and powers of attorney — the documents that protect your family if something happens to you.</p>
      <span class="v2-help-card-link">Learn more &rarr;</span>
    </a>
    <a href="/who-we-serve/business-owners" class="v2-help-card">
      <div class="v2-help-card-img">
        <img src="/images/macbookimage.jpg" alt="Business estate and tax planning" loading="lazy">
      </div>
      <h3>Business &amp; Tax</h3>
      <p>Business succession planning, entity formation, QSBS strategies, commercial lease review, and asset protection for owners who've built something worth protecting.</p>
      <span class="v2-help-card-link">Learn more &rarr;</span>
    </a>
  </div>
  <div class="v2-howwehelp-cta">
    <a href="/services" class="v2-btn-outline">View All Services</a>
  </div>
</section>


<!-- ═══════════════════════════════════
     WORK WITH US — About teaser
═══════════════════════════════════ -->
<section class="v2-workwithus">
  <div class="v2-workwithus-inner">
    <div class="v2-workwithus-text">
      <div class="v2-section-label">Work With Us</div>
      <h2 class="v2-section-title">National-caliber estate planning with <em>Mesa roots</em>.</h2>
      <p>Mesa Estate Planning was founded on a simple idea: every family deserves the kind of thoroughness and personal attention that most firms reserve for their wealthiest clients. We bring big-firm training and small-firm care to every client we serve.</p>
      <a href="/about" class="v2-btn-outline">See What Makes Us Different</a>
    </div>
    <div class="v2-workwithus-img">
      <img src="/images/family-hero.jpg" alt="Mesa Estate Planning team" loading="lazy">
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════
     RESOURCES — 3 article cards
═══════════════════════════════════ -->
<section class="v2-resources">
  <div class="v2-resources-header">
    <div class="v2-section-label">Resources</div>
    <h2 class="v2-section-title">Plain-English estate planning guidance</h2>
    <p class="v2-resources-sub">We help you understand the complex, take control, and make informed decisions about your future.</p>
  </div>
  <div class="v2-resources-cards">
    <a href="/blog/arizona-family-living-trust" class="v2-resource-card">
      <div class="v2-resource-tag">Trusts</div>
      <h3>Does Every Arizona Family Need a Living Trust?</h3>
      <p>We break down when a trust makes sense, what it costs, and why Arizona's probate process makes this decision critical.</p>
      <span class="v2-resource-link">Read more &rarr;</span>
    </a>
    <a href="/our-process" class="v2-resource-card">
      <div class="v2-resource-tag">Process</div>
      <h3>What to Expect When You Work With Us</h3>
      <p>From free consultation to signed documents and funded trust — a five-step process designed around your situation.</p>
      <span class="v2-resource-link">Read more &rarr;</span>
    </a>
    <a href="/pricing" class="v2-resource-card">
      <div class="v2-resource-tag">Pricing</div>
      <h3>How Our Flat-Fee Pricing Works</h3>
      <p>All work is flat-fee, quoted after the free consultation. You know the total cost before you commit to anything.</p>
      <span class="v2-resource-link">Read more &rarr;</span>
    </a>
  </div>
</section>


<!-- ═══════════════════════════════════
     CONTACT CTA
═══════════════════════════════════ -->
<section class="v2-contact-cta">
  <div class="v2-contact-cta-overlay"></div>
  <div class="v2-contact-cta-inner">
    <div class="v2-section-label" style="color:rgba(255,255,255,0.5);">Contact Us</div>
    <h2 class="v2-contact-cta-title">Let's get started</h2>
    <p class="v2-contact-cta-body">Your first consultation is completely free. We'll learn about your situation and tell you exactly what you need — no pressure, no sales pitch.</p>
    <a href="/contact" class="v2-contact-cta-btn">Book Free Consultation</a>
  </div>
</section>

</BaseLayout>
