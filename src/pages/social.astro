---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Social Media & Reviews | Mesa Estate Planning"
  description="Connect with Mesa Estate Planning on social media and leave a review. Follow us on Facebook, LinkedIn, X, and Instagram. Leave a Google or Yelp review."
  keywords="mesa estate planning social media, mesa estate planning reviews, estate planning attorney mesa az reviews"
>
  <section class="services-index-hero">
    <div class="services-index-hero-content">
      <div class="hero-eyebrow" style="opacity:1;animation:none;">Connect With Us</div>
      <h1 class="hero-h1" style="opacity:1;animation:none;">Social Media <em>&amp; Reviews</em></h1>
      <p class="hero-body" style="opacity:1;animation:none;">Follow us for estate planning tips, firm updates, and Arizona legal insights — or let us know how we did.</p>
    </div>
  </section>

  <section class="services-index-grid">

    <!-- Social Media -->
    <div class="services-index-section">
      <div class="services-index-label">Follow Us</div>
      <div class="services-card-grid" style="grid-template-columns: repeat(2, 1fr);">

        <a href="#" class="services-index-card social-card" target="_blank" rel="noopener">
          <div class="social-card-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--sage)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </div>
          <h3>Facebook</h3>
          <p>Estate planning tips, firm news, and community updates for Mesa and the East Valley.</p>
          <span class="services-card-link">Follow on Facebook &rarr;</span>
        </a>

        <a href="#" class="services-index-card social-card" target="_blank" rel="noopener">
          <div class="social-card-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--sage)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
          </div>
          <h3>LinkedIn</h3>
          <p>Professional insights on estate planning, business succession, and Arizona legal developments.</p>
          <span class="services-card-link">Connect on LinkedIn &rarr;</span>
        </a>

        <a href="#" class="services-index-card social-card" target="_blank" rel="noopener">
          <div class="social-card-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--sage)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4l6.5 8L4 20h2l5.5-6.8L16 20h4l-6.8-8.4L20 4h-2l-5.2 6.4L8 4H4z"/></svg>
          </div>
          <h3>X (Twitter)</h3>
          <p>Quick updates, legal commentary, and estate planning insights in real time.</p>
          <span class="services-card-link">Follow on X &rarr;</span>
        </a>

        <a href="#" class="services-index-card social-card" target="_blank" rel="noopener">
          <div class="social-card-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--sage)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </div>
          <h3>Instagram</h3>
          <p>Behind-the-scenes at the firm, Mesa community involvement, and visual estate planning education.</p>
          <span class="services-card-link">Follow on Instagram &rarr;</span>
        </a>

      </div>
    </div>

    <!-- Reviews -->
    <div class="services-index-section">
      <div class="services-index-label">Leave a Review</div>
      <div class="services-card-grid" style="grid-template-columns: repeat(2, 1fr);">

        <a href="#" class="services-index-card social-card" target="_blank" rel="noopener">
          <div class="social-card-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--bronze)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/></svg>
          </div>
          <h3>Google Review</h3>
          <p>Share your experience working with Mesa Estate Planning on Google. Your review helps other families find the right attorney.</p>
          <span class="services-card-link">Leave a Google Review &rarr;</span>
        </a>

        <a href="#" class="services-index-card social-card" target="_blank" rel="noopener">
          <div class="social-card-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--bronze)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/></svg>
          </div>
          <h3>Yelp Review</h3>
          <p>Let others know about your experience on Yelp. We appreciate every review — it helps us continue to serve the Mesa community well.</p>
          <span class="services-card-link">Leave a Yelp Review &rarr;</span>
        </a>

      </div>
    </div>

    <div class="services-index-cta">
      <h2>Ready to start your estate plan?</h2>
      <p>Whether you found us through social media or a friend's recommendation, the first step is always a free consultation.</p>
      <a href="/contact" class="btn-bronze">Book Free Consultation</a>
    </div>
  </section>
</BaseLayout>
