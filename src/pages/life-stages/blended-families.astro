<ServiceLayout
  title="Estate Planning for Blended Families | Arizona | Mesa Estate Planning"
  description="Blended families need QTIP trusts, separate property protection, and careful beneficiary planning. Arizona estate planning for stepchildren, second marriages, and prior-relationship children."
  heroTitle="Your family is more complicated than a standard estate plan assumes."
  heroSubtitle="Stepchildren have no automatic inheritance rights in Arizona. Assets left outright to a surviving spouse may never reach your children from a prior marriage. A blended family plan addresses what default law ignores."
  breadcrumbParent="Life Stages"
  breadcrumbParentUrl="/life-stages"
  keywords="blended family estate planning arizona, QTIP trust arizona, stepchildren inheritance rights, second marriage estate plan, estate planning remarriage mesa az"
  relatedServices={[
    { title: 'Wills & Trusts', href: '/services/wills-and-trusts', desc: 'QTIP trusts, disclaimer trusts, and marital planning.' },
    { title: 'Asset Protection', href: '/services/asset-protection', desc: 'Protect separate property brought into the marriage.' },
    { title: 'Estate Tax Planning', href: '/services/estate-tax-planning', desc: 'Tax-efficient structures for combined family wealth.' },
