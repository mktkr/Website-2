---
import BlogLayout from '../../layouts/BlogLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const related = post.data.relatedResources || [];
---

<BlogLayout
  title={post.data.title}
  description={post.data.description}
  publishDate={post.data.publishDate}
  author={post.data.author}
  category={post.data.category}
  readTime={post.data.readTime}
  keywords={post.data.keywords}
  ogImage={post.data.ogImage}
>
  {post.data.heroImage && (
    <div class="article-hero-img">
      <img
        src={post.data.heroImage}
        alt={post.data.heroAlt ?? post.data.title}
        width="1200" height="630"
        loading="eager" decoding="async"
      />
    </div>
  )}

  <Content />

  {post.data.closingImage && (
    <div class="article-closing-img">
      <img
        src={post.data.closingImage}
        alt={post.data.closingAlt ?? `${post.data.title} — Mesa Estate Planning`}
        width="1200" height="500"
        loading="lazy" decoding="async"
      />
    </div>
  )}

  {related.length > 0 && (
    <div class="article-related">
      <div class="article-related-label">Related Resources</div>
      <div class="article-related-grid">
        {related.map(r => (
          <a href={r.href} class="article-related-card">
            <span class="article-related-card-label">{r.label}</span>
            <h4>{r.title}</h4>
            <p>{r.description}</p>
          </a>
        ))}
      </div>
    </div>
  )}
</BlogLayout>
