---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);
const featuredPosts = allPosts.filter(p => p.data.featured);
const INITIAL_SHOW = 6;
---

<BaseLayout
  title="Estate Planning Articles & Guides | Mesa, AZ | Mesa Estate Planning"
  description="Plain-English articles, guides, and resources on Arizona estate planning, trusts, wills, business succession, asset protection, and tax planning."
  keywords="arizona estate planning articles, living trust guide arizona, estate planning resources mesa az"
>
  <section class="services-index-hero">
    <div class="services-index-hero-content">
      <div class="hero-eyebrow" style="opacity:1;animation:none;">Resources</div>
      <h1 class="hero-h1" style="opacity:1;animation:none;">Plain-English guides to <em>Arizona estate planning</em></h1>
      <p class="hero-body" style="opacity:1;animation:none;">No jargon. No fluff. Just clear answers to the questions our clients ask most often — written by the attorneys who handle these issues every day.</p>
    </div>
  </section>

  {featuredPosts.length > 0 && (
    <section class="blog-featured-section">
      <div class="blog-section-label">Featured</div>
      <div class="blog-carousel" id="featured-carousel">
        {featuredPosts.map(post => (
          <a href={`/blog/${post.slug}/`} class="blog-featured-card">
            {post.data.heroImage && (
              <div class="blog-featured-img">
                <img src={post.data.heroImage} alt={post.data.title}
                  width="600" height="315" loading="lazy" decoding="async" />
              </div>
            )}
            <div class="blog-featured-body">
              <div class="blog-card-meta">
                <span class="blog-card-category">{post.data.category}</span>
                <span class="blog-card-dot">&middot;</span>
                <span class="blog-card-readtime">{post.data.readTime}</span>
              </div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <span class="services-card-link">Read article &rarr;</span>
            </div>
          </a>
        ))}
      </div>
      {featuredPosts.length > 1 && (
        <div class="blog-carousel-dots" id="carousel-dots">
          {featuredPosts.map((_, i) => (
            <button class={`blog-carousel-dot ${i === 0 ? 'active' : ''}`}
              data-index={i} aria-label={`Go to slide ${i + 1}`} />
          ))}
        </div>
      )}
    </section>
  )}

  <section class="services-index-grid">
    <div class="services-index-section">
      <div class="services-index-label">All Articles</div>
      <div class="services-card-grid" id="articles-grid">
        {allPosts.map((post, i) => (
          <a href={`/blog/${post.slug}/`}
            class={`services-index-card ${i >= INITIAL_SHOW ? 'blog-hidden' : ''}`}
            data-blog-card>
            <div class="blog-card-meta">
              <span class="blog-card-category">{post.data.category}</span>
              <span class="blog-card-dot">&middot;</span>
              <span class="blog-card-readtime">{post.data.readTime}</span>
            </div>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <span class="services-card-link">Read article &rarr;</span>
          </a>
        ))}
      </div>
      {allPosts.length > INITIAL_SHOW && (
        <div class="blog-see-more-wrapper">
          <button class="btn-bronze-outline" id="see-more-btn">See more articles</button>
        </div>
      )}
    </div>
    <div class="services-index-cta">
      <h2>Have a question we haven't covered?</h2>
      <p>We're always adding new articles based on what our clients ask. In the meantime, a free consultation is the fastest way to get a clear answer to your specific situation.</p>
      <a href="/contact" class="btn-bronze">Book Free Consultation</a>
    </div>
  </section>
</BaseLayout>

<style>
  .blog-featured-section { padding: 0 var(--page-px, 20px) 32px; max-width: 960px; margin: 0 auto; }
  .blog-section-label { font-size: 0.65rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--sage, #5C7A6B); font-weight: 600; margin-bottom: 16px; padding-top: 8px; border-top: 1px solid var(--sand, #EDE8DF); }
  .blog-carousel { display: flex; gap: 20px; overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; scrollbar-width: none; padding-bottom: 8px; }
  .blog-carousel::-webkit-scrollbar { display: none; }
  .blog-featured-card { flex: 0 0 100%; scroll-snap-align: start; border: 1px solid var(--sand, #EDE8DF); border-radius: 6px; overflow: hidden; text-decoration: none; color: inherit; display: flex; flex-direction: column; transition: border-color 0.2s; }
  .blog-featured-card:hover { border-color: var(--bronze, #9C7E4A); }
  .blog-featured-img { line-height: 0; overflow: hidden; }
  .blog-featured-img img { width: 100%; height: auto; aspect-ratio: 600 / 315; object-fit: cover; display: block; }
  .blog-featured-body { padding: 20px 24px 24px; }
  .blog-featured-body h3 { font-family: var(--serif, 'Cormorant Garamond', Georgia, serif); font-size: 1.35rem; font-weight: 500; line-height: 1.25; color: var(--charcoal, #2C2C2C); margin-bottom: 8px; }
  .blog-featured-body p { font-size: 0.88rem; line-height: 1.6; color: var(--mid-gray, #6B6560); font-weight: 300; margin-bottom: 12px; }
  .blog-card-meta { display: flex; gap: 8px; align-items: center; margin-bottom: 10px; }
  .blog-card-category { font-size: 0.65rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--sage, #5C7A6B); font-weight: 600; }
  .blog-card-dot { font-size: 0.65rem; color: var(--mid-gray, #6B6560); }
  .blog-card-readtime { font-size: 0.65rem; color: var(--mid-gray, #6B6560); }
  .blog-carousel-dots { display: flex; justify-content: center; gap: 8px; margin-top: 16px; }
  .blog-carousel-dot { width: 8px; height: 8px; border-radius: 50%; border: none; background: var(--sand, #EDE8DF); cursor: pointer; padding: 0; transition: background 0.2s, width 0.2s; }
  .blog-carousel-dot.active { background: var(--sage, #5C7A6B); width: 24px; border-radius: 4px; }
  .blog-see-more-wrapper { text-align: center; margin-top: 24px; }
  .btn-bronze-outline { display: inline-block; background: transparent; color: var(--bronze, #9C7E4A); font-size: 0.82rem; font-weight: 500; letter-spacing: 0.06em; padding: 10px 28px; border-radius: 4px; border: 1px solid var(--bronze, #9C7E4A); cursor: pointer; text-transform: uppercase; transition: background 0.2s, color 0.2s; }
  .btn-bronze-outline:hover { background: var(--bronze, #9C7E4A); color: #FAF8F4; }
  .blog-hidden { display: none; }
  @media (min-width: 641px) {
    .blog-featured-card { flex: 0 0 calc(50% - 10px); }
    .blog-carousel { overflow-x: visible; flex-wrap: wrap; }
    .blog-carousel-dots { display: none; }
  }
</style>

<script is:inline>
(function() {
  var carousel = document.getElementById('featured-carousel');
  var dots = document.querySelectorAll('.blog-carousel-dot');
  if (carousel && dots.length > 0) {
    carousel.addEventListener('scroll', function() {
      var card = carousel.querySelector('.blog-featured-card');
      if (!card) return;
      var index = Math.round(carousel.scrollLeft / (card.offsetWidth + 20));
      dots.forEach(function(dot, i) { dot.classList.toggle('active', i === index); });
    });
    dots.forEach(function(dot) {
      dot.addEventListener('click', function() {
        var index = parseInt(this.dataset.index);
        var card = carousel.querySelector('.blog-featured-card');
        if (card) carousel.scrollTo({ left: index * (card.offsetWidth + 20), behavior: 'smooth' });
      });
    });
  }
  var btn = document.getElementById('see-more-btn');
  if (btn) {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.blog-hidden').forEach(function(c) { c.classList.remove('blog-hidden'); });
      btn.style.display = 'none';
    });
  }
})();
</script>
